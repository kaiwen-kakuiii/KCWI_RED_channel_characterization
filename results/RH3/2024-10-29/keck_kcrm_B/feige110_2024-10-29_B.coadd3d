# feige110, 2024-10-29 setup B; airmass 1.29-1.31
# align is deliberately NOT set: measured on RH2 2023-11-07 B, align=True and align=False give
# byte-identical cube geometry, because the header WCS already places a small nod correctly.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige110_2024-10-29_B.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20241030.17851.58-feige110_KCRM_20241030T045731.622.fits
Science/spec2d_KR.20241030.18213.69-feige110_KCRM_20241030T050333.725.fits
spec2d end
