# feige110, 2024-11-06 setup B; airmass 1.10-1.10
# align is deliberately NOT set: measured on RH2 2023-11-07 B, align=True and align=False give
# byte-identical cube geometry, because the header WCS already places a small nod correctly.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige110_2024-11-06_B.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20241107.22892.91-feige110_KCRM_20241107T062132.890.fits
Science/spec2d_KR.20241107.23242.77-feige110_KCRM_20241107T062722.810.fits
spec2d end
