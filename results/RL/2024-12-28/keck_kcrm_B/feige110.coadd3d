# Coadd feige110 frames for 2024-12-28 keck_kcrm_B into one datacube.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige110_2024-12-28_B.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20241229.18207.94-feige110_KCRM_20241229T050327.936.fits
Science/spec2d_KR.20241229.18306.88-feige110_KCRM_20241229T050506.864.fits
Science/spec2d_KR.20241229.18404.80-feige110_KCRM_20241229T050644.842.fits
spec2d end
