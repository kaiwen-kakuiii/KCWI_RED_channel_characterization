# Coadd feige110 frames for 2024-07-06 keck_kcrm_B into one datacube.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige110_2024-07-06_B.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20240707.53501.23-feige110_KCRM_20240707T145141.213.fits
Science/spec2d_KR.20240707.53601.19-feige110_KCRM_20240707T145321.178.fits
Science/spec2d_KR.20240707.53690.95-feige110_KCRM_20240707T145450.947.fits
spec2d end
