# feige34, 2024-04-30 setup B, cenwave 8900; airmass 1.10-1.10
# align is deliberately NOT set: measured on RH2 2023-11-07 B, align=True and align=False give
# byte-identical cube geometry, because the header WCS already places a small nod correctly.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige34_2024-04-30_B.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20240501.20184.16-feige34_KCRM_20240501T053623.645.fits
Science/spec2d_KR.20240501.20393.20-feige34_KCRM_20240501T053953.770.fits
Science/spec2d_KR.20240501.20594.21-feige34_KCRM_20240501T054313.699.fits
spec2d end
