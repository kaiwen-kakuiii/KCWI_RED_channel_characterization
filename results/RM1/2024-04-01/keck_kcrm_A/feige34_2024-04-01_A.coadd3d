# feige34, 2024-04-01 setup A, cenwave 6130; airmass 1.33-1.35
# align is deliberately NOT set: measured on RH2 2023-11-07 B, align=True and align=False give
# byte-identical cube geometry, because the header WCS already places a small nod correctly.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige34_2024-04-01_A.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20240402.19809.27-Feige34_KCRM_20240402T053009.274.fits
Science/spec2d_KR.20240402.20060.19-Feige34_KCRM_20240402T053420.179.fits
spec2d end
