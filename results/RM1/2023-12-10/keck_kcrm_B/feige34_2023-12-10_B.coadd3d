# feige34, 2023-12-10 setup B, cenwave 7510; airmass 1.09-1.09
# align is deliberately NOT set: measured on RH2 2023-11-07 B, align=True and align=False give
# byte-identical cube geometry, because the header WCS already places a small nod correctly.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige34_2023-12-10_B.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20231211.56927.52-feige34_KCRM_20231211T154848.010.fits
Science/spec2d_KR.20231211.56986.68-feige34_KCRM_20231211T154947.194.fits
Science/spec2d_KR.20231211.57045.84-feige34_KCRM_20231211T155046.378.fits
spec2d end
