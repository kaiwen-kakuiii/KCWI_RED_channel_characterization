# feige34, 2023-12-10 setup C, cenwave 6630; airmass 1.09-1.09
# align is deliberately NOT set: measured on RH2 2023-11-07 B, align=True and align=False give
# byte-identical cube geometry, because the header WCS already places a small nod correctly.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige34_2023-12-10_C.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20231211.56420.58-feige34_KCRM_20231211T154020.064.fits
Science/spec2d_KR.20231211.56497.80-feige34_KCRM_20231211T154136.614.fits
Science/spec2d_KR.20231211.56556.24-feige34_KCRM_20231211T154235.712.fits
Science/spec2d_KR.20231211.56615.40-feige34_KCRM_20231211T154334.896.fits
spec2d end
