# feige34, 2024-12-28 setup B; airmass 1.15-1.15
# align is deliberately NOT set: measured on RH2 2023-11-07 B, align=True and align=False give
# byte-identical cube geometry, because the header WCS already places a small nod correctly.
[rdx]
    spectrograph = keck_kcrm

[reduce]
    [[cube]]
        combine = True
        output_filename = feige34_2024-12-28_B.fits
        save_whitelight = True

spec2d read
filename
Science/spec2d_KR.20241229.57359.86-feige34_KCRM_20241229T155559.837.fits
Science/spec2d_KR.20241229.57596.50-feige34_KCRM_20241229T155956.486.fits
spec2d end
